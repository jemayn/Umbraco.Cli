<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Umbraco.Cli</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>umbraco</ToolCommandName>
    <PackageId>Umbraco.Cli</PackageId>
    <Title>Umbraco CLI</Title>
    <Description>Command-line tool for Umbraco products and services in development and CI pipelines.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="NuGet.Versioning" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the tests check that each product or service with commands has a package tag -->
    <AssemblyMetadata Include="PackageTags" Value="$(PackageTags)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Umbraco.Cli.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <!-- The Product catalogue and the Cloud scaffold files used by umbraco cloud init -->
  <ItemGroup>
    <EmbeddedResource Include="Cloud\Init\catalog.json" LogicalName="catalog.json" />
    <EmbeddedResource Include="Cloud\Init\Scaffold\**\*.template" LogicalName="Scaffold/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
